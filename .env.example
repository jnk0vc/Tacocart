# Copy to .env.local for `npm run dev`. Never commit real keys.
# The app runs without these (mock PayPal + scripted guide). A judged demo
# needs a PayPal Sandbox client id/secret AND one LLM key.

# --- PayPal Sandbox (server only; the client id is also sent to the widget) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live. Hackathon demos should stay on sandbox.
# The Agent Toolkit defaults to the LIVE API unless context.sandbox is set.
# This app sets that from PAYPAL_ENVIRONMENT, which defaults to sandbox.
PAYPAL_ENVIRONMENT=sandbox
# mock | live | (empty = mock when either credential is missing, otherwise live)
PAYPAL_MODE=
# Used if the browser falls back to a full-page PayPal redirect.
# Defaults to the request Origin, then http://localhost:3000.
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# --- LLM (Vercel AI SDK). Set LLM_PROVIDER and the matching key. ---
# openai (default) | anthropic | google
LLM_PROVIDER=openai
# Optional override. Defaults: gpt-4o-mini, claude-3-5-haiku-latest, gemini-2.0-flash.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# auto (default) uses the agent when the selected key is present.
# fallback forces the scripted guide so the widget can be tried with no LLM.
LLM_MODE=

# --- Widget ---
# Origin allowed to call the API from another site. * is fine for a public demo.
WIDGET_ALLOWED_ORIGIN=*

# Set to 1 to log agent tool calls on the server.
TACOCART_DEBUG=
